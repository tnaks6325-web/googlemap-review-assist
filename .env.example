# 이 파일을 복사해 .env 로 만들고 값을 채우세요: cp .env.example .env
# .env 는 .gitignore에 의해 커밋되지 않습니다(비밀값 보관용).

# DB 접속 문자열
# - 로컬 개발(SQLite, 기본): file:./dev.db
# - 운영(PostgreSQL 예시): postgresql://user:password@host:5432/dbname?schema=public
DATABASE_URL="file:./dev.db?connection_limit=1"

# DB 종류: sqlite(기본, 로컬) | postgres(운영). postgres면 money 트랜잭션이 Serializable+재시도로 실행.
DB_PROVIDER="sqlite"
# 운영(PostgreSQL) 예시 — docs/POSTGRES.md 참고:
# DB_PROVIDER="postgres"
# DATABASE_URL="postgresql://review:review@localhost:5432/review?schema=public&connection_limit=10"

# 세션 쿠키 서명용 비밀키 (운영에서는 안전한 난수 32바이트 이상으로 교체)
# 생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-secret"

# 적립 정책 포인트 (피드백 1건 제출당)
EARN_POINTS="500"

# 개발 편의: OTP 인증번호를 응답에 노출(값이 "1"이고 비운영일 때만). 운영에서는 비워두세요.
OTP_DEV_ECHO="1"

# CSRF 방어용 추가 허용 출처(쉼표 구분). 동일 출처는 자동 허용.
# ALLOWED_ORIGINS="https://app.example.com"

# 최소 정산 금액(P)
SETTLE_MIN="5000"

# 관리자 정산 처리용 토큰 (x-admin-token 헤더, 부트스트랩/자동화용). 운영에서는 강력한 난수로 교체.
ADMIN_TOKEN="change-me-admin-token"
# money 액션(정산 승인/반려)에 토큰 폴백 허용 여부. 기본(미설정)은 실 관리자 세션만 허용(F1).
# ADMIN_TOKEN_MONEY="1"

# 신뢰하는 프록시 홉 수. 0(기본)이면 X-Forwarded-For를 신뢰하지 않음(스푸핑 방지, F2).
# 운영에서 프록시/로드밸런서 뒤라면 그 홉 수로 설정.
TRUSTED_PROXY_COUNT="0"

# 선택: 설정 시 Claude API로 초안 생성, 미설정 시 로컬 폴백 사용
# ANTHROPIC_API_KEY=""
# AI_MODEL="claude-haiku-4-5"
