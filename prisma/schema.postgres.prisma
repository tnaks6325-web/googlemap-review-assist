// PostgreSQL 운영 스키마. SQLite 스키마(schema.prisma)와 모델 정의는 동일하다.
// String/JSON 어댑트를 유지하므로 enum/배열 복원 없이 그대로 호환된다.
// 사용: prisma <cmd> --schema=prisma/schema.postgres.prisma  (DATABASE_URL=Postgres 접속 문자열)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- 사장님 / 매장 ----------
model Owner {
  id         String     @id @default(cuid())
  email      String     @unique
  password   String // 해시
  businesses Business[]
  createdAt  DateTime   @default(now())
}

// 운영 관리자(정산 승인·어뷰징 모니터링)
model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String // 해시
  createdAt DateTime @default(now())
}

model Business {
  id               String            @id @default(cuid())
  ownerId          String
  owner            Owner             @relation(fields: [ownerId], references: [id])
  name             String
  address          String?
  googlePlaceId    String?
  menus            Menu[]
  campaigns        Campaign[]
  receipts         Receipt[]
  externalPlaces   ExternalPlace[]
  externalReviews  ExternalReview[]
  externalSyncLogs ExternalSyncLog[]
  subscription     Subscription?
  createdAt        DateTime          @default(now())
}

// 외부 플랫폼 플레이스 스냅샷. 분석/연결 전용이며 AI 초안 입력으로 사용하지 않는다.
model ExternalPlace {
  id                 String           @id @default(cuid())
  businessId         String
  business           Business         @relation(fields: [businessId], references: [id])
  platform           String // GOOGLE | NAVER
  externalId         String?
  url                String?
  name               String
  address            String?
  phone              String?
  category           String?
  lat                Float?
  lng                Float?
  rating             Float?
  reviewCount        Int?
  receiptReviewCount Int?
  matchStatus        String           @default("LINKED") // LINKED | NEEDS_REVIEW | FAILED
  matchConfidence    Int?
  rawJson            String?
  syncedAt           DateTime?
  createdAt          DateTime         @default(now())
  reviews            ExternalReview[]

  @@unique([businessId, platform])
  @@index([platform])
}

// 외부 리뷰는 사장님 분석 전용. 보상/AI 초안/고객 리뷰 생성과 연결하지 않는다.
model ExternalReview {
  id               String         @id @default(cuid())
  businessId       String
  business         Business       @relation(fields: [businessId], references: [id])
  externalPlaceId  String?
  externalPlace    ExternalPlace? @relation(fields: [externalPlaceId], references: [id])
  platform         String // GOOGLE | NAVER
  reviewType       String         @default("UNKNOWN") // GENERAL | RECEIPT | BOOKING | ORDER | UNKNOWN
  rating           Int?
  content          String?
  authorMasked     String?
  publishedAt      DateTime?
  externalReviewId String?
  reviewHash       String         @unique
  rawJson          String?
  syncedAt         DateTime?
  createdAt        DateTime       @default(now())

  @@index([businessId])
  @@index([externalPlaceId])
}

model ExternalSyncLog {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  platform   String // GOOGLE | NAVER
  status     String // SUCCESS | FAILED
  message    String?
  createdAt  DateTime @default(now())

  @@index([businessId, platform])
}

model Menu {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  name       String
  category   String?

  @@index([businessId])
}

model Campaign {
  id                      String                          @id @default(cuid())
  businessId              String
  business                Business                        @relation(fields: [businessId], references: [id])
  slug                    String                          @unique
  name                    String
  active                  Boolean                         @default(true)
  totalQuota              Int?
  dailyQuota              Int?
  startDate               String?
  endDate                 String?
  rewardPoints            Int                             @default(500)
  receipts                Receipt[]
  codes                   CampaignCode[]
  blogReferences          CampaignBlogReference[]
  draftGuidance           CampaignDraftGuidance?
  draftEvidence           CampaignDraftEvidence[]
  // Keep these production relations mapped so populated archive tables are never dropped.
  preparedDraftBatches CampaignPreparedDraftBatch[]
  preparedDrafts       CampaignPreparedDraft[]
  preparedDraftRevisions CampaignPreparedDraftRevision[]
  reviewDrafts         CampaignReviewDraft[]
  sheetCampaignSource  SheetCampaignSource?
  automationRuns       CampaignAutomationRun[]
  nextReviewDraftSequence Int                             @default(0)
  createdAt               DateTime                        @default(now())
}

// 원고 생성에 사용할 관리자 입력 사실과 업종별 금지 표현.
// SQLite 호환을 위해 목록은 JSON 문자열로 저장한다.
model CampaignDraftGuidance {
  id                 String   @id @default(cuid())
  campaignId         String   @unique
  campaign           Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  industry           String?
  approvedFactsJson  String   @default("[]")
  bannedTermsJson    String   @default("[]")
  guideKeywordsJson  String   @default("[]")
  reviewExamplesJson String   @default("[]")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model CampaignBlogReference {
  id          String    @id @default(cuid())
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id])
  source      String    @default("NAVER_BLOG_SEARCH")
  searchQuery String
  title       String
  description String?
  link        String
  bloggerName String?
  bloggerLink String?
  postdate    String?
  publishedAt DateTime?
  rawJson     String?
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([campaignId, link])
  @@index([campaignId, status])
  @@index([campaignId, createdAt])
}

model CampaignDraftEvidence {
  id            String   @id @default(cuid())
  campaignId    String
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  facet         String
  fact          String
  sourceType    String
  sourceRef     String
  sourceExcerpt String
  status        String   @default("APPROVED") // legacy column; fact cards are applied automatically
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([campaignId, facet, fact, sourceRef])
  @@index([campaignId, status])
}

// 관리자 사전생성 실행 단위. 생성 당시의 공급자·품질 지표를 보존한다.
model CampaignPreparedDraftBatch {
  id               String                  @id @default(cuid())
  campaignId       String
  campaign         Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  provider         String
  model            String
  sourceGroupsJson String
  sourceGroupCount Int
  promptVersion    String
  metricsJson      String
  drafts           CampaignPreparedDraft[]
  generatedAt      DateTime                @default(now())

  @@index([campaignId, generatedAt])
}

// 사전생성 원고 풀. 품질제외 원고도 감사·확인을 위해 함께 보존한다.
model CampaignPreparedDraft {
  id                String                     @id @default(cuid())
  campaignId        String
  campaign          Campaign                   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  batchId           String
  batch             CampaignPreparedDraftBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  slot              Int
  styleId           String
  toneLabel         String
  structureLabel    String
  text              String
  evidenceIdsJson   String                     @default("[]")
  maxSimilarity     Float
  qualityPassed     Boolean
  assignedReceiptId String?
  assignedReceipt   Receipt?                   @relation(fields: [assignedReceiptId], references: [id], onDelete: SetNull)
  assignedAt        DateTime?
  createdAt         DateTime                   @default(now())
  legacyDraftId     String?                    @unique

  @@unique([batchId, styleId])
  @@index([campaignId, qualityPassed, assignedReceiptId, createdAt])
  @@index([batchId])
}

// 관리자가 원고를 고친 전후 문장을 보존한다. draftId는 원고 삭제 후에도 감사·문체 개선에
// 활용할 수 있도록 의도적으로 외래키를 걸지 않은 스냅샷 식별자다.
model CampaignPreparedDraftRevision {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  draftId    String
  adminId    String
  beforeText String
  afterText  String
  createdAt  DateTime @default(now())

  @@index([campaignId, createdAt])
  @@index([draftId, createdAt])
}

// Legacy production pool retained so existing drafts can be migrated without data loss.
model CampaignReviewDraft {
  id                String    @id @default(cuid())
  campaignId        String
  campaign          Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sequence          Int
  text              String
  provider          String
  model             String
  sourceGroupsJson  String
  contextHash       String
  generatedAt       DateTime
  version           Int       @default(1)
  styleId           String?
  evidenceIdsJson   String?
  similarity        Float?
  promptVersion     String?
  assignedReceiptId String?   @unique
  assignedReceipt   Receipt?  @relation(fields: [assignedReceiptId], references: [id], onDelete: SetNull)
  assignedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([campaignId, sequence])
  @@index([campaignId, assignedReceiptId, sequence])
}

// 업체가 발급한 1회용 인증 코드(영수증/POS 연동 전 단계의 검증 수단).
// R1: 자가신고 임의 코드가 아니라 발급된 미사용 코드와 일치할 때만 VERIFIED.
model CampaignCode {
  id         String    @id @default(cuid())
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id])
  code       String // 정규화된 코드
  used       Boolean   @default(false)
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@unique([campaignId, code])
  @@index([campaignId])
}

// ---------- 고객 / 적립 ----------
model Reviewer {
  id            String                 @id @default(cuid())
  phone         String?                @unique
  googleSub     String?                @unique
  email         String?
  name          String?
  avatarUrl     String?
  wallet        PointWallet?
  receipts      Receipt[]
  transactions  PointTransaction[]
  settlements   Settlement[]
  payoutAccount ReviewerPayoutAccount?
  notifications ReviewerNotification[]
  createdAt     DateTime               @default(now())
}

model PointWallet {
  id         String   @id @default(cuid())
  reviewerId String   @unique
  reviewer   Reviewer @relation(fields: [reviewerId], references: [id])
  balance    Int      @default(0) // 원장 합계 캐시
}

model Receipt {
  id                          String                  @id @default(cuid())
  businessId                  String
  business                    Business                @relation(fields: [businessId], references: [id])
  campaignId                  String
  campaign                    Campaign                @relation(fields: [campaignId], references: [id])
  reviewerId                  String
  reviewer                    Reviewer                @relation(fields: [reviewerId], references: [id])
  code                        String? // 승인번호/식별 코드
  amount                      Int?
  merchantName                String?
  ocrText                     String? // OCR 원문(truncated)
  reviewDraftText             String?
  reviewDraftProvider         String?
  reviewDraftModel            String?
  reviewDraftSourceGroupsJson String?
  reviewDraftContextHash      String?
  reviewDraftGeneratedAt      DateTime?
  reviewDraftVersion          Int                     @default(0)
  reviewDraftSequence         Int?
  reviewDraftStyleId          String?
  reviewDraftEvidenceIdsJson  String?
  reviewDraftSimilarity       Float?
  reviewDraftPromptVersion    String?
  reviewProofImageUrl         String?
  reviewProofMimeType         String?
  reviewProofOriginalName     String?
  reviewProofSubmittedAt      DateTime?
  assignmentExpiresAt         DateTime?
  rewardPoints                Int?
  reviewProofExtractedText    String?
  reviewProofSimilarity       Float?
  reviewProofAnalysisStatus   String?
  reviewProofAnalysisReason   String?
  reviewProofAnalysisProvider String?
  reviewProofAnalysisJson     String?
  reviewReviewedAt            DateTime?
  reviewReviewedBy            String?
  reviewReviewNote            String?
  source                      String                  @default("CODE") // CODE | OCR | CAMPAIGN_ASSIGNMENT
  dedupeHash                  String                  @unique // 동일 영수증 재사용 차단
  status                      String                  @default("PENDING") // PENDING | VERIFIED | ASSIGNED | REVIEW_SUBMITTED | COMPLETED | REJECTED | EXPIRED
  feedback                    Feedback?
  assignedPreparedDrafts CampaignPreparedDraft[]
  campaignReviewDraft    CampaignReviewDraft?
  createdAt                   DateTime                @default(now())

  @@index([reviewerId])
  @@index([reviewerId, createdAt])
  @@index([businessId])
  @@index([campaignId, status])
  @@index([status])
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model OperationalJob {
  id          String    @id @default(cuid())
  type        String
  status      String    @default("PENDING")
  dedupeKey   String    @unique
  payloadJson String
  attempts    Int       @default(0)
  maxAttempts Int       @default(4)
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  lastError   String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
}

// 신규 캠페인 일일 자동화 실행. runKey로 같은 KST 날짜의 중복 trigger를 방지한다.
model AutomationRun {
  id          String                  @id @default(cuid())
  runKey      String                  @unique
  status      String                  @default("QUEUED") // QUEUED | RUNNING | COMPLETED | DEGRADED | FAILED
  startedAt   DateTime?
  completedAt DateTime?
  lastError   String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  campaigns   CampaignAutomationRun[]

  @@index([status, createdAt])
}

// 시트 행의 안정적인 식별자와 마지막 반영 내용을 보존한다. 행 번호는 변경될 수 있으므로 식별자가 아니다.
model SheetCampaignSource {
  id             String                   @id @default(cuid())
  sourceKey      String                   @unique
  spreadsheetId  String
  sheetName      String
  receiptId      String?
  rowNumber      Int
  sourceStatus   String                   @default("READY") // READY | INVALID
  contentHash    String
  contentJson    String
  campaignId     String?                  @unique
  campaign       Campaign?                @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  automationRuns CampaignAutomationRun[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([spreadsheetId, sheetName])
  @@index([sourceStatus])
}

// 일일 실행 안에서 특정 캠페인의 단계별 진행·재시도 상태를 기록한다.
model CampaignAutomationRun {
  id              String               @id @default(cuid())
  automationRunId String
  automationRun   AutomationRun        @relation(fields: [automationRunId], references: [id], onDelete: Cascade)
  campaignId      String
  campaign        Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sourceId        String?
  source          SheetCampaignSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  stage           String               @default("DISCOVERED")
  status          String               @default("QUEUED") // QUEUED | PROCESSING | RETRY | READY | NEEDS_REVIEW | FAILED
  attempts        Int                  @default(0)
  maxAttempts     Int                  @default(3)
  nextRetryAt     DateTime?
  lockedAt        DateTime?
  lastError       String?
  completedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([automationRunId, campaignId])
  @@index([status, nextRetryAt])
  @@index([sourceId])
}

model OperationalError {
  id               String    @id @default(cuid())
  fingerprint      String    @unique
  severity         String
  source           String
  workflow         String
  stage            String
  code             String
  title            String
  situation        String
  cause            String
  impact           String
  action           String
  narrative        String
  technicalName    String?
  technicalMessage String?
  digest           String?
  route            String?
  method           String?
  requestId        String?
  entityType       String?
  entityId         String?
  metadataJson     String?
  status           String    @default("OPEN")
  occurrenceCount  Int       @default(1)
  firstOccurredAt  DateTime  @default(now())
  lastOccurredAt   DateTime  @default(now())
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, severity, lastOccurredAt])
  @@index([workflow, lastOccurredAt])
}

model Feedback {
  id          String            @id @default(cuid())
  receiptId   String            @unique // 1 영수증 1 설문
  receipt     Receipt           @relation(fields: [receiptId], references: [id])
  rating      Int // 1..5
  menuIdsJson String            @default("[]") // 선택 메뉴 id 배열(JSON)
  comment     String?
  status      String            @default("SUBMITTED")
  drafts      AiDraft[]
  earnTx      PointTransaction? // 이 설문이 발생시킨 EARN (1:1)
  createdAt   DateTime          @default(now())
}

model AiDraft {
  id         String   @id @default(cuid())
  feedbackId String
  feedback   Feedback @relation(fields: [feedbackId], references: [id])
  version    Int
  text       String
  createdAt  DateTime @default(now())

  @@unique([feedbackId, version])
}

// append-only 원장. EARN은 Feedback 또는 승인된 캠페인 검수에서만 발생한다.
model PointTransaction {
  id             String      @id @default(cuid())
  reviewerId     String
  reviewer       Reviewer    @relation(fields: [reviewerId], references: [id])
  type           String // EARN | REDEEM | SETTLE | ADJUST
  amount         Int // EARN 양수, REDEEM/SETTLE 음수
  feedbackId     String?     @unique
  feedback       Feedback?   @relation(fields: [feedbackId], references: [id])
  settlementId   String?
  settlement     Settlement? @relation(fields: [settlementId], references: [id])
  idempotencyKey String      @unique // EARN/SETTLE 등 상태 전이별 1회 보장
  memo           String?
  createdAt      DateTime    @default(now())

  @@index([reviewerId, createdAt])
}

// 정산(출금) 요청/처리
model Settlement {
  id           String             @id @default(cuid())
  reviewerId   String
  reviewer     Reviewer           @relation(fields: [reviewerId], references: [id])
  amount       Int // 양수(요청 금액)
  method       String // 예: BANK
  payoutInfo   String? // JSON (계좌 등)
  status       String             @default("REQUESTED") // REQUESTED | APPROVED | PAID | REJECTED
  processedBy  String? // 처리한 관리자 식별(F1 감사)
  transactions PointTransaction[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([reviewerId])
  @@index([status])
}

model ReviewerPayoutAccount {
  id               String   @id @default(cuid())
  reviewerId       String   @unique
  reviewer         Reviewer @relation(fields: [reviewerId], references: [id])
  bankName         String
  accountNumberEnc String
  accountLast4     String
  accountHolder    String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ReviewerNotification {
  id           String    @id @default(cuid())
  reviewerId   String
  reviewer     Reviewer  @relation(fields: [reviewerId], references: [id])
  type         String
  title        String
  body         String
  metadataJson String?
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([reviewerId, createdAt])
}

// 사장님 구독(플랫폼 수익)
model Subscription {
  id         String   @id @default(cuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id])
  plan       String // 예: BASIC | PRO
  status     String   @default("ACTIVE") // ACTIVE | PAST_DUE | CANCELED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// 휴대폰 OTP 인증 챌린지
model OtpChallenge {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
}
